# ビルド対象の upstream (github.com/openbao/openbao-plugins) の固定値。
# このファイルを変更して main にマージすると、新しいイメージが push される。
#
# UPSTREAM_REPOSITORY : GitHub の owner/name。
# UPSTREAM_REF        : 必ず 40 桁の commit SHA で固定する (ブランチ名/タグ名は不可)。
# PLUGIN              : upstream Makefile の PLUGIN 名 (<type>-<name>)。
# PLUGIN_VERSION      : secrets/ldap/CHANGELOG.md の最新版に、自前ビルドであることを
#                       示す "-sm.<UPSTREAM_REF 先頭7桁>" を付けた semver。
#                       イメージタグ / OpenBao plugin stanza の version としてそのまま使う。
#                       既存タグの上書きは workflow が拒否するので、変更時は必ず更新する。
UPSTREAM_REPOSITORY=openbao/openbao-plugins
UPSTREAM_REF=20f394ef24edee76ac3da44f48b8dcc4aae39afd
PLUGIN=secrets-ldap
PLUGIN_VERSION=v0.0.1-sm.20f394e
